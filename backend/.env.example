# LLM Provider selection: 'mock' (default), 'openai', or 'gemini'
LLM_PROVIDER=mock

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Live LLM API Keys (Mock provider is used if left blank)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
